{
    "name": "componenta/mimetype-detector",
    "description": "MIME type detection helpers for Componenta",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "componenta/config": "^4.0",
        "ext-fileinfo": "*",
        "psr/container": "^2.0",
        "psr/http-message": "^2.0"
    },
    "require-dev": {
        "guzzlehttp/psr7": "^3.6",
        "pestphp/pest": "^4.0",
        "phpbench/phpbench": "^1.7",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "Componenta\\Detector\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Componenta\\Detector\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php vendor/bin/pest",
        "analyse": "@php vendor/bin/phpstan analyse src --level=max --no-progress",
        "bench": "@php vendor/bin/phpbench run --report=aggregate",
        "check": [
            "@catalog-check",
            "@test",
            "@analyse"
        ],
        "catalog-generate": "@php scripts/generate-catalog.php",
        "catalog-check": "@php scripts/generate-catalog.php --check"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "componenta": {
            "config-providers": [
                "Componenta\\Detector\\ConfigProvider"
            ]
        },
        "branch-alias": {
            "dev-refactor/mimetype-detector-v3": "3.0.x-dev"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
