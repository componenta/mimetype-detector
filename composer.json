{
    "name": "componenta/mimetype-detector",
    "description": "MIME type detection helpers for Componenta",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "ext-fileinfo": "*",
        "componenta/config": "^1.0 || ^2.0.2",
        "psr/http-message": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Componenta\\Detector\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Componenta\\Detector\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit tests"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "componenta": {
            "config-providers": [
                "Componenta\\Detector\\ConfigProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
